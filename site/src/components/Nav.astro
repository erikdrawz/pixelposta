---
// The skin picker replaces the old light/dark toggle. Világos and Sötét are the
// editorial defaults; the rest are optional costumes defined in styles/skins.css.
//
// Each entry pins a theme as well as a skin, so anything a skin does not
// explicitly restyle still lands on a coherent palette.
const SKINS = [
  { id: 'light', label: 'Világos' },
  { id: 'dark', label: 'Sötét' },
  { id: '98', label: 'Win98' },
  { id: 'xp', label: 'WinXP' },
  { id: 'winamp', label: 'Winamp' },
  { id: 'nostromo', label: 'Nostromo' },
];

// One list, rendered twice: inline above the collapse breakpoint, inside the
// hamburger below it. Duplicating three anchors in the DOM is cheaper than the
// alternatives — a `<details>` cannot be reliably forced open across browsers
// to serve as the desktop layout, because engines hide its contents with
// content-visibility rather than display.
//
// `#hirlevel` stays a bare fragment so it scrolls to the subscribe block on the
// page you are already on, rather than throwing you back to the landing page.
// That holds because every content page ends with one — landing, issue, naptar
// and info. The exception is 404.astro, where the link does nothing; adding a
// subscribe block to an error page to fix that would be worse than the bug.
const LINKS = [
  { href: '#hirlevel', label: 'Hírlevél' },
  { href: '/naptar/', label: 'Naptár' },
  { href: '/info/', label: 'Infó' },
];
---

<nav>
  <div class="nav-in">
    <a class="wordmark" href="/">PIXEL<span>POSTA</span></a>

    <div class="navlinks">
      {LINKS.map((l) => <a class="nav-issue" href={l.href}>{l.label}</a>)}
    </div>

    {/* Window chrome — decorative, only visible in the desktop skins. */}
    <div class="winbtns" aria-hidden="true"><i>_</i><i>□</i><i>✕</i></div>

    {/* A native disclosure rather than a scripted dropdown, so the nav still
        opens with JavaScript off. site/README.md states that nothing on the
        site becomes unreachable without JS, and a scripted hamburger would
        have made these links exactly that on a phone. The script below only
        adds Escape and outside-click, which are enhancements, not the mechanism. */}
    <details class="navpick" id="nav-disclosure">
      <summary class="toggle" aria-label="Menü">
        <span class="burger" aria-hidden="true"></span>
      </summary>
      <div class="navmenu">
        {LINKS.map((l) => <a class="nav-issue" href={l.href}>{l.label}</a>)}
      </div>
    </details>

    <div class="skinpick">
      <button
        class="toggle"
        id="skin-trigger"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="skin-menu"
        aria-label="Stílus váltása"
      >
        <span class="sk-swatch" aria-hidden="true"></span>
        <span class="sk-label" aria-hidden="true"></span>
        <span class="sk-caret" aria-hidden="true">▾</span>
      </button>

      <div class="skinmenu" id="skin-menu" role="menu" aria-label="Stílus" hidden>
        {
          SKINS.map((s) => (
            <button role="menuitemradio" aria-checked="false" data-skin-id={s.id} type="button">
              <span class:list={['sk-swatch', `sk-sw-${s.id}`]} aria-hidden="true" />
              {s.label}
              <span class="sk-tick" aria-hidden="true">
                ✓
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    // Mirrors the table in the no-FOUC script in Base.astro. Kept in both
    // places on purpose: that one must run in <head> before any markup exists,
    // this one needs the nav to be parsed.
    var SKINS = {
      light: { theme: 'light' },
      dark: { theme: 'dark' },
      '98': { theme: 'light', skin: '98' },
      xp: { theme: 'light', skin: 'xp' },
      winamp: { theme: 'dark', skin: 'winamp' },
      nostromo: { theme: 'dark', skin: 'nostromo' },
    };

    var el = document.documentElement;
    var trigger = document.getElementById('skin-trigger');
    var menu = document.getElementById('skin-menu');
    var disclosure = document.getElementById('nav-disclosure');
    if (!trigger || !menu) return;
    var items = Array.prototype.slice.call(menu.querySelectorAll('[data-skin-id]'));

    function mark(id) {
      items.forEach(function (b) {
        b.setAttribute('aria-checked', b.dataset.skinId === id ? 'true' : 'false');
      });
    }

    function apply(id) {
      var s = SKINS[id];
      if (!s) return;
      el.dataset.theme = s.theme;
      if (s.skin) el.dataset.skin = s.skin;
      else delete el.dataset.skin;
      el.dataset.skinId = id;
      mark(id);
      try {
        localStorage.setItem('pp-skin', id);
      } catch (e) {
        /* private mode — the choice still applies for this page view */
      }
    }

    function closeNav() {
      if (disclosure) disclosure.open = false;
    }
    function open() {
      // Two popovers in one small bar: opening either closes the other.
      closeNav();
      menu.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
    }
    function close() {
      menu.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    }

    mark(el.dataset.skinId || 'light');

    trigger.addEventListener('click', function (e) {
      e.stopPropagation();
      menu.hidden ? open() : close();
    });

    items.forEach(function (b) {
      b.addEventListener('click', function () {
        apply(b.dataset.skinId);
        close();
        trigger.focus();
      });
    });

    if (disclosure) {
      disclosure.addEventListener('toggle', function () {
        if (disclosure.open) close();
      });
    }

    document.addEventListener('click', function (e) {
      if (!menu.hidden && !menu.contains(e.target) && e.target !== trigger) close();
      if (disclosure && disclosure.open && !disclosure.contains(e.target)) closeNav();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      if (!menu.hidden) {
        close();
        trigger.focus();
      }
      if (disclosure && disclosure.open) {
        closeNav();
        var s = disclosure.querySelector('summary');
        if (s) s.focus();
      }
    });
  })();
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 60;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
  }
  .nav-in {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 var(--pad);
    height: 100%;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .wordmark {
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.04em;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
    line-height: 1;
  }
  .wordmark span {
    color: var(--accent);
  }
  .navlinks {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .nav-issue {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-issue:hover {
    color: var(--accent);
  }
  .toggle {
    border-radius: 999px;
    border: 1px solid var(--rule-strong);
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    font-size: 13px;
    flex-shrink: 0;
  }
  .toggle:hover {
    color: var(--ink);
    border-color: var(--ink-muted);
  }

  /* ---- hamburger ---- */

  /* Above the breakpoint the links are inline and this does not exist. */
  .navpick {
    display: none;
    position: relative;
    flex-shrink: 0;
  }
  .navpick > summary {
    /* Carries `.toggle`, so all four costume skins already style it. */
    width: 34px;
    height: 31px;
    display: grid;
    place-items: center;
    list-style: none;
  }
  .navpick > summary::-webkit-details-marker {
    display: none;
  }
  .navpick > summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* Drawn rather than typed: a glyph would pick up each skin's font and change
     size and weight with it. currentColor keeps it in step with the button. */
  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 15px;
    height: 2px;
    background: currentColor;
  }
  .burger {
    position: relative;
  }
  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .burger::before {
    top: -5px;
  }
  .burger::after {
    top: 5px;
  }
  /* The panel's box — position, surface, border, shadow — comes from the
     shared `.skinmenu, .navmenu` rule in styles/skins.css, which is also where
     each costume skin restyles it. Only the parts specific to a list of links
     live here. */
  .navmenu {
    display: flex;
    flex-direction: column;
  }
  .navmenu .nav-issue {
    padding: 10px 9px;
    border-radius: 6px;
    color: var(--ink);
  }
  .navmenu .nav-issue:hover {
    background: var(--bg-band);
  }

  /* Below the breakpoint the links collapse into the hamburger. The skin picker
     stays out of it — it is the most discoverable thing in the nav, and nesting
     a six-item radio menu inside a disclosure would make it a two-level menu.
     It sheds its label instead and rides as a swatch. */
  @media (max-width: 560px) {
    .navlinks {
      display: none;
    }
    .navpick {
      display: block;
    }
    .nav-in {
      gap: 10px;
    }
  }
</style>
