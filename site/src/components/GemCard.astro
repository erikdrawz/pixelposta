---
interface Props {
  title: string;
  genre: string;
  description: string;
  appid: number;
}

const { title, genre, description, appid } = Astro.props;

// Capsule art is not stored in the repo — it is hotlinked from Steam's CDN by
// appid. Verified against the current host: `shared.cloudflare.steamstatic.com`
// serves capsule_616x353.jpg for live apps and returns a clean 404 otherwise,
// which the onerror handler below turns into "no art" rather than a broken
// image icon. Keeping this out of Astro's asset pipeline also keeps the build
// from depending on Steam being reachable.
const capsule = `https://shared.cloudflare.steamstatic.com/store_item_assets/steam/apps/${appid}/capsule_616x353.jpg`;
const storeUrl = `https://store.steampowered.com/app/${appid}/`;
---

<div class="gem">
  <div class="gem-head">
    <h3>{title}</h3>
    <span class="gem-tag">{genre}</span>
  </div>

  <p>{description}</p>

  <div class="capsule">
    <img
      src={capsule}
      alt=""
      width="616"
      height="353"
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
      onerror="this.closest('.capsule')?.remove()"
    />
  </div>

  <p class="src-line">
    <a class="src" href={storeUrl} target="_blank" rel="noopener">Steam →</a>
  </p>
</div>

<style>
  .gem {
    max-width: var(--measure);
    padding-bottom: 44px;
    margin-bottom: 44px;
    border-bottom: 1px solid var(--rule);
  }
  .gem:last-of-type {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .gem-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .gem h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h2);
    line-height: 1.24;
    letter-spacing: -0.014em;
    margin: 0;
  }
  .gem-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 3px 8px;
    border-radius: 999px;
    opacity: 0.8;
  }
  .gem p {
    margin: 0 0 20px;
  }
  .gem p.src-line {
    margin: 0;
  }
  .capsule {
    aspect-ratio: 616 / 353;
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    background: var(--bg-band);
    margin-bottom: 18px;
  }
  .capsule img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
