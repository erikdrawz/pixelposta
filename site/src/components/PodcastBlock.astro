---
// Sits directly under RadarBlock at the foot of every content page, and shares
// its box so the two read as a pair rather than as two unrelated panels.
//
// The two blocks never point at the page you are already on: /indie-radar/
// carries this one alone and /podcast/ carries RadarBlock alone, so neither
// page offers a link back to itself.
import { PODCAST_NAME } from '../consts';
---

<div class="sub">
  {/* Rendered uppercase by CSS — written in sentence case here. */}
  <div class="sub-label">Podcast</div>
  <h2>Podcastot hallgatnál?</h2>
  <p>
    Indie, AA, történet-alapú videójátékok, gamer nosztalgia, Resident Evil és az élet dolgai a
    {' '}{PODCAST_NAME} csapatától.
  </p>
  <a class="btn" href="/podcast/">Meghallgatom →</a>
</div>

<style>
  .sub {
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 28px 30px;
    max-width: var(--measure);
  }
  .sub-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 11px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.015em;
    margin: 0 0 10px;
  }
  p {
    margin: 0 0 20px;
    font-size: 1rem;
    color: var(--ink-muted);
  }
</style>
