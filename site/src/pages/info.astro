<style>
  .info-head h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.1rem, 5vw, 3.1rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 10px 0 16px;
  }
  .standfirst {
    font-size: 1.06rem;
    line-height: 1.62;
    max-width: var(--measure);
    color: var(--ink);
    margin: 0;
  }
  p {
    max-width: var(--measure);
  }
</style>
