---
// Self-hosted fonts. Archivo, Literata and JetBrains Mono all carry full
// Latin Extended-A, which is what Hungarian needs — ő and ű included.
// Silkscreen has neither, so only its Latin subset is loaded: it is used for
// the wordmark and the footer mark, both pure ASCII, and nowhere else.
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource/silkscreen/latin-700.css';

import '../styles/tokens.css';
import '../styles/global.css';

import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description: string;
  /** The cover itself, so its real dimensions can be declared. Made absolute
   *  against `site` for Open Graph. */
  ogImage?: ImageMetadata;
  /** Alt text for the Open Graph image. */
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** ISO date — emitted as article:published_time on issue pages. */
  publishedTime?: string;
  /** schema.org structured data, serialised into a ld+json block. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  publishedTime,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ? new URL(ogImage.src, Astro.site).href : undefined;

// `</script>` inside a JSON string would close the block early; escaping the
// angle bracket is the standard guard for inline ld+json.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;

// Cloudflare Web Analytics. Cookieless and no-op until the token is set —
// see site/README.md for where to find it.
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Default is index,follow; stated explicitly so the image-preview
        directive rides along — without it Google may only show a thumbnail. */}
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Pixelposta" />
    <meta property="og:locale" content="hu_HU" />
    {
      ogImage && ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          {/* Read off the actual asset, not assumed: the editor commits covers
              at whatever size they have, and a wrong box makes previews
              reflow or crop badly. */}
          <meta property="og:image:width" content={String(ogImage.width)} />
          <meta property="og:image:height" content={String(ogImage.height)} />
          <meta property="og:image:alt" content={ogImageAlt ?? title} />
          <meta name="twitter:image" content={ogImageUrl} />
        </>
      )
    }
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    {jsonLdText && <script type="application/ld+json" is:inline set:html={jsonLdText} />}

    <meta name="theme-color" content="#FBF9F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171512" media="(prefers-color-scheme: dark)" />

    {/* Runs before first paint so the chosen theme never flashes. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('pp-theme');
          var theme =
            stored ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${beaconToken}"}`}
      />
    )}
  </head>

  <body>
    <a class="skip" href="#main">Ugrás a tartalomra</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="foot-mark">PIXELPOSTA · {new Date().getFullYear()}</div>
    </footer>
  </body>
</html>

<style>
  footer {
    padding: 44px 0 70px;
    text-align: center;
  }
  .foot-mark {
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: var(--text-micro);
    color: var(--ink-muted);
    opacity: 0.55;
    letter-spacing: 0.04em;
  }
</style>
