---
// "Listen on" row under the player.
//
// The marks are drawn inline rather than pulled from an icon set: the site
// ships no icon font and no third-party script, and currentColor is what lets
// one set of paths work against all six skins without a per-skin override.
//
// Each is a recognisable monochrome reduction of the platform's own mark, at
// the size a link row needs — not a full-colour brand logo.
import { PODCAST_NAME, PODCAST_PLATFORMS } from '../consts';
---

<div class="platforms">
  <p class="platforms-label">Hallgasd az alábbi platformokon:</p>

  <ul class="platform-list">
    {
      PODCAST_PLATFORMS.map((p) => (
        <li>
          <a
            href={p.href}
            target="_blank"
            rel="noopener"
            aria-label={`${PODCAST_NAME} — ${p.label}`}
            title={p.label}
          >
            {p.icon === 'spotify' && (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.586 14.424a.623.623 0 0 1-.857.207c-2.348-1.435-5.304-1.76-8.785-.964a.623.623 0 1 1-.277-1.215c3.809-.871 7.077-.496 9.712 1.115a.623.623 0 0 1 .207.857Zm1.223-2.722a.78.78 0 0 1-1.072.257c-2.687-1.652-6.785-2.131-9.965-1.166a.78.78 0 1 1-.452-1.492c3.632-1.102 8.147-.568 11.232 1.329a.78.78 0 0 1 .257 1.072Zm.105-2.835C14.698 8.953 9.375 8.78 6.329 9.705a.934.934 0 1 1-.542-1.788c3.497-1.062 9.376-.857 13.07 1.336a.934.934 0 1 1-.953 1.614Z"
                />
              </svg>
            )}

            {p.icon === 'apple' && (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M12 2a10 10 0 0 0-5.2 18.54.5.5 0 0 0 .76-.54l-.3-1.3A8.5 8.5 0 1 1 16.74 18.7l-.3 1.3a.5.5 0 0 0 .76.54A10 10 0 0 0 12 2Zm0 3.6a6.4 6.4 0 0 0-3.47 11.78.5.5 0 0 0 .75-.56l-.32-1.3A4.9 4.9 0 1 1 15.04 15.5l-.32 1.3a.5.5 0 0 0 .75.57A6.4 6.4 0 0 0 12 5.6Zm0 3.3a2.35 2.35 0 0 0-1.17 4.39c.3.17.45.5.38.83l-.84 3.95A1.65 1.65 0 0 0 12 20.1a1.65 1.65 0 0 0 1.63-2.03l-.84-3.95a.83.83 0 0 1 .38-.83A2.35 2.35 0 0 0 12 8.9Z"
                />
              </svg>
            )}

            {p.icon === 'youtube' && (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M23.5 6.9a3.02 3.02 0 0 0-2.12-2.14C19.5 4.25 12 4.25 12 4.25s-7.5 0-9.38.51A3.02 3.02 0 0 0 .5 6.9C0 8.79 0 12 0 12s0 3.21.5 5.1a3.02 3.02 0 0 0 2.12 2.14c1.88.51 9.38.51 9.38.51s7.5 0 9.38-.51a3.02 3.02 0 0 0 2.12-2.14C24 15.21 24 12 24 12s0-3.21-.5-5.1ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z"
                />
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .platforms {
    max-width: var(--measure);
    margin-top: 22px;
  }
  .platforms-label {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    margin: 0 0 12px;
  }
  .platform-list {
    display: flex;
    align-items: center;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* A 44px box around a 26px mark: the tap target meets the usual minimum
     without the icons drifting apart on a phone. */
  .platform-list a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    border: 1px solid var(--rule-strong);
    color: var(--ink-muted);
    text-decoration: none;
  }
  .platform-list a:hover {
    color: var(--accent);
    border-color: var(--ink-muted);
  }
  .platform-list a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .platform-list svg {
    width: 26px;
    height: 26px;
    display: block;
  }
</style>
