---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  genre: string;
  description: string;
  appid: number;
  /** Committed capsule art, named `ajanlo-<appid>.jpg` in the issue folder. */
  image?: ImageMetadata;
}

const { title, genre, description, appid, image } = Astro.props;

// Capsule art is committed alongside the issue rather than hotlinked. Steam's
// asset URLs were derivable from the appid alone for older titles, but newer
// store items sit behind a per-asset content hash — and those hashes differ
// between assets of the same game, so nothing can be reconstructed from the
// appid. New indie releases are precisely what this section features, so the
// derivable-URL approach failed for its main use case.
//
// No image committed means no art: the card still carries the title, genre,
// description and Steam link, which is the graceful outcome either way.
const storeUrl = `https://store.steampowered.com/app/${appid}/`;
---

<div class="gem">
  <div class="gem-head">
    <h3>{title}</h3>
    <span class="gem-tag">{genre}</span>
  </div>

  <p>{description}</p>

  {
    image && (
      <div class="capsule">
        <Image
          src={image}
          alt=""
          widths={[400, 616]}
          sizes="(max-width: 820px) 100vw, 700px"
          format="webp"
          loading="lazy"
        />
      </div>
    )
  }

  <p class="src-line">
    <a class="src" href={storeUrl} target="_blank" rel="noopener">Steam →</a>
  </p>
</div>

<style>
  .gem {
    max-width: var(--measure);
    padding-bottom: 44px;
    margin-bottom: 44px;
    border-bottom: 1px solid var(--rule);
  }
  .gem:last-of-type {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .gem-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .gem h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h2);
    line-height: 1.24;
    letter-spacing: -0.014em;
    margin: 0;
  }
  .gem-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 3px 8px;
    border-radius: 999px;
    opacity: 0.8;
  }
  .gem p {
    margin: 0 0 20px;
  }
  .gem p.src-line {
    margin: 0;
  }
  .capsule {
    aspect-ratio: 616 / 353;
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    background: var(--bg-band);
    margin-bottom: 18px;
  }
  .capsule :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
