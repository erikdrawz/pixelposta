---
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import { issueUrl, weekLabel } from '../utils/format';

interface Props {
  issue: CollectionEntry<'issues'>;
}

const { issue } = Astro.props;
const { year, week, title, standfirst, cover } = issue.data;
---

{/* Issue-level, so it stays visible in every rovat. */}
<div class="prev-wrap">
  <div class="wrap">
    <div class="prev-label">Előző szám</div>

    <a class="prev" href={issueUrl(issue)}>
      <Cover
        cover={cover}
        mark="PP"
        submark={`${week}. HÉT`}
        widths={[168, 336]}
        sizes="(max-width: 600px) 280px, 168px"
      />
      <div>
        <div class="row-week">{weekLabel(year, week)}</div>
        <h3 class="row-title">{title}</h3>
        <p class="row-desc prev-desc">{standfirst}</p>
      </div>
      <div class="prev-arrow" aria-hidden="true">→</div>
    </a>

    <div class="prev-all"><a href="/">Összes szám →</a></div>
  </div>
</div>

<style>
  .prev-wrap {
    padding: 52px 0 12px;
  }
  .prev-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 16px;
  }
  .prev {
    display: grid;
    grid-template-columns: 168px 1fr auto;
    gap: 24px;
    align-items: center;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 20px;
  }
  .prev:hover {
    border-color: var(--accent);
  }
  .prev:hover .row-title {
    color: var(--accent);
  }
  .prev:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .prev-desc {
    margin-bottom: 0;
  }
  .prev-arrow {
    font-family: var(--font-mono);
    font-size: 19px;
    color: var(--ink-muted);
    padding-right: 6px;
  }
  .prev-all {
    margin-top: 18px;
  }
  .prev-all a {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .prev-all a:hover {
    color: var(--accent);
  }
  @media (max-width: 600px) {
    .prev {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .prev :global(.cover) {
      max-width: 280px;
    }
    .prev-arrow {
      display: none;
    }
  }
</style>
