# Copy to .env and fill in. Never commit .env.

# Anthropic API key — used by the pre-filter (Haiku) and the draft generator (Sonnet).
# Get one at https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# Notion integration token — create at https://www.notion.so/profile/integrations
# Then share both databases with the integration from inside Notion.
NOTION_TOKEN=

# Notion database IDs. Open the database as a page, copy the URL, the ID is the
# 32-char string before the "?v=" query parameter.
NOTION_ARTICLES_DB_ID=
NOTION_ISSUES_DB_ID=
