---
import { SUBSTACK_URL } from '../consts';
---

<div class="sub">
  {/* Rendered uppercase by CSS — written in sentence case here. */}
  <div class="sub-label">Pixelposta hírlevél</div>
  <h2>Pixelposta egyenesen az email fiókodba</h2>
  <p>
    A heti videójátékos híreket elküldjük neked minden hétvégén, hogy ne maradj le semmiről. Zéró
    spam, zéró bullshit.
  </p>
  <a class="btn" href={SUBSTACK_URL} target="_blank" rel="noopener">Feliratkozom →</a>
</div>

<style>
  .sub {
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 28px 30px;
    max-width: var(--measure);
  }
  .sub-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 11px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.015em;
    margin: 0 0 10px;
  }
  p {
    margin: 0 0 20px;
    font-size: 1rem;
    color: var(--ink-muted);
  }
</style>
